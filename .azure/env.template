# Azure App Service Environment Variables Template
# Copy this file and fill in the values for your Azure App Service deployment
# Set these in Azure Portal: App Service > Configuration > Application settings
# Or use Azure CLI: az webapp config appsettings set --resource-group <resource-group> --name <app-name> --settings KEY=VALUE

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Port is automatically set by Azure App Service, but you can override if needed
# PORT=3000

# Node environment
NODE_ENV=production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DB_CONN=your_mongodb_atlas_connection_string

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Redis Cloud connection string
# Format: redis://:<password>@<host>:<port> or rediss:// for SSL
REDIS_URL=your_redis_cloud_connection_string

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Example: https://your-guest-app.azurestaticapps.net,https://your-admin-app.azurestaticapps.net
ALLOWED_ORIGINS=https://your-guest-app.azurestaticapps.net,https://your-admin-app.azurestaticapps.net

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
# Secret keys for JWT token generation and verification
# Generate strong random strings (at least 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters

# ============================================================================
# PAYMONGO CONFIGURATION
# ============================================================================
# PayMongo API configuration
# Get these from your PayMongo dashboard: https://dashboard.paymongo.com/
PAYMONGO_SECRET_KEY=sk_live_your_paymongo_secret_key
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYMONGO_BASE_URL=https://api.paymongo.com/v1

# ============================================================================
# GOOGLE CLOUD STORAGE CONFIGURATION
# ============================================================================
# Google Cloud Storage bucket name
BUCKET_NAME=your_gcs_bucket_name

# Prefix for facility images in GCS
FACILITY_IMAGE_PREFIX=facility_images/

# Google Cloud Storage service account credentials
# Option 1: Upload the JSON file to Azure App Service and set the path
# Option 2: Set the JSON content as an environment variable (see below)
GOOGLE_APPLICATION_CREDENTIALS=/home/site/wwwroot/modules/your-service-account.json

# Alternative: If you prefer to use environment variable instead of file path,
# you can set the entire JSON content as a base64-encoded string or use
# individual credential fields (requires code changes)

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# SMTP email configuration for sending emails
# For Gmail, use App Password: https://support.google.com/accounts/answer/185833
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password

# ============================================================================
# OAUTH CONFIGURATION
# ============================================================================
# Google OAuth credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth credentials
# Get these from Facebook Developers: https://developers.facebook.com/
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit actual values to version control
# 2. Use Azure Key Vault for sensitive values in production
# 3. For Google Cloud Storage credentials:
#    - Upload the service account JSON file via Azure Portal > App Service > Deployment Center
#    - Or use Azure File Share to mount the credentials file
#    - Or set individual credential fields as environment variables (requires code modification)
# 4. Update ALLOWED_ORIGINS with your actual Azure Static Web Apps URLs after deployment
# 5. Ensure all URLs in ALLOWED_ORIGINS have no trailing slashes
# 6. Test webhook endpoints after deployment to ensure PayMongo can reach your API

